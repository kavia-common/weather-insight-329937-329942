},"type":"object","required":["detail"],"title":"ErrorResponse","description":"Standard error response."},"ForecastItem":{"properties":{"timestamp_utc":{"type":"string","format":"date-time","title":"Timestamp Utc","description":"Forecast time in UTC."},"temp_c":{"type":"number","title":"Temp C","description":"Temperature in Celsius."},"conditions":{"items":{"$ref":"#/components/schemas/WeatherCondition"},"type":"array","title":"Conditions","description":"Weather conditions list."},"icon_url":{"type":"string","title":"Icon Url","description":"Convenience URL for the primary icon."}},"type":"object","required":["timestamp_utc","temp_c","conditions","icon_url"],"title":"ForecastItem","description":"A single forecast data point (3-hour step from OpenWeatherMap forecast API)."},"ForecastResponse":{"properties":{"city":{"type":"string","title":"City","description":"City name."},"country":{"type":"string","title":"Country","description":"Country code."},"items":{"items":{"$ref":"#/components/schemas/ForecastItem"},"type":"array","title":"Items","description":"Forecast items (3-hour increments)."}},"type":"object","required":["city","country","items"],"title":"ForecastResponse","description":"5-day forecast response for a city."},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"},"WeatherCondition":{"properties":{"main":{"type":"string","title":"Main","description":"Group of weather parameters (Rain, Snow, etc.)."},"description":{"type":"string","title":"Description","description":"Condition description (human-readable)."},"icon":{"type":"string","title