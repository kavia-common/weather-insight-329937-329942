# Copy to `.env` (do not commit secrets).
#
# Backend base URL for the FastAPI service that exposes:
#   GET /weather/current?city=London
#   GET /weather/forecast?city=London
#
# For Android emulator: http://10.0.2.2:3001
# For iOS simulator:    http://127.0.0.1:3001
# For hosted backend:   https://<your-host>:3001
BACKEND_BASE_URL=http://10.0.2.2:3001

# Optional default city when no last city is stored.
DEFAULT_CITY=London
